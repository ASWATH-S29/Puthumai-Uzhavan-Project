# ─────────────────────────────────────────────────────────────
# Puthumai Uzhavan v2.0 — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── Frontend / public configuration (safe for the browser) ──

# Supabase project URL and anon key (required)
# These are public by design — the anon key is safe to expose.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" to force mock data mode (offline development).
# When unset or "false", the app calls the Edge Functions.
VITE_USE_MOCK=false

# ── Server / Edge Function secrets (NEVER expose in the browser) ──
# These are set as Supabase Edge Function secrets, NOT as VITE_ vars.
# Configure them in the Supabase dashboard under Edge Functions > Secrets.
#
# GEMINI_API_KEY        — Google Gemini API key (https://aistudio.google.com)
# OPENWEATHER_API_KEY   — OpenWeather API key (https://openweathermap.org/api)
