# ─────────────────────────────────────────────────────────────
# Puthumai Uzhavan v2.0 — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini AI (required for AI Assistant features)
# Get a free key at https://aistudio.google.com
VITE_GEMINI_API_KEY=

# OpenWeather API (required for Weather page)
# Get a free key at https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# Set to "true" to use mock data (offline development)
VITE_USE_MOCK=false
